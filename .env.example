# ── VK community (REQUIRED) ────────────────────────────────────────────────
# Access token with "Manage community" + "Community messages" scopes
# (Community -> Manage -> Settings -> API usage -> Access tokens). Keep it secret.
VK_GROUP_TOKEN=

# VK community id as a POSITIVE integer (WITHOUT the leading minus sign)
VK_GROUP_ID=

# Owner's numeric VK user id; messages from anyone else are ignored.
# Find yours via https://vk.com/ (id is in the page URL) or any "my id" service.
VK_ALLOWED_USER_ID=

# ── OpenCode (REQUIRED model, rest optional) ───────────────────────────────
# OpenCode server URL (default: http://localhost:4096). Start it with
# `opencode serve` or via ./start.sh
# OPENCODE_API_URL=http://localhost:4096

# Default model passed to OpenCode prompts (REQUIRED)
OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=big-pickle

# OpenCode server authentication (optional)
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# Auto-restart a local OpenCode server when health checks fail (default: false).
# Only applies when OPENCODE_API_URL points to localhost.
# OPENCODE_AUTO_RESTART_ENABLED=false
# OPENCODE_MONITOR_INTERVAL_SEC=300

# ── VK transport tuning (optional) ─────────────────────────────────────────
# VK API version (default: 5.199)
# VK_API_VERSION=5.199

# Bots Long Poll wait in seconds (default: 25, clamped to 5..90)
# VK_LONG_POLL_WAIT_SEC=25

# Attachment download cap in MB per incoming photo/document/voice (default: 45)
# VK_MAX_ATTACHMENT_MB=45

# TEST-ONLY: let the bot process its own "SELFTEST:"-marked messages so
# flows can be driven without the owner (used by scripts/vk-live-selftest.mjs).
# Must stay disabled in production.
# VK_SELF_TEST=0

# ── Logging (optional) ─────────────────────────────────────────────────────
# debug, info, warn, error (default: info). "debug" logs every update,
# outbound send and button tap — useful while bringing the bot up.
# LOG_LEVEL=info

# Number of log files to keep (default: 10)
# LOG_RETENTION=10

# ── UI language (optional) ─────────────────────────────────────────────────
# Supported locales: en, ru, ar, de, es, fr, it, ko, pt, zh (default: en)
# BOT_LOCALE=ru

# ── Voice messages / Speech-to-Text (optional) ─────────────────────────────
# Without this block, voice notes use VK's built-in transcripts when the
# community has voice transcription enabled; otherwise the bot answers
# "voice input is not configured".
# With a Whisper-compatible endpoint configured, downloaded voice notes are
# transcribed via {STT_API_URL}/audio/transcriptions (multipart by default).
# Providers verified against VK voice notes (ogg/opus): Groq, OpenAI.
# z.ai GLM-ASR currently accepts only wav/mp3 and clips at 30 seconds.
# STT_API_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=ru
# STT_REQUEST_FORMAT=multipart
# STT_NOTE_PROMPT=
